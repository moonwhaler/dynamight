# Patterns match from the context root only; "**/" matches at any depth.

# Build artifacts. frontend/node_modules must stay out: COPY frontend/ would
# otherwise overwrite the modules npm ci installed for Alpine with the host's.
target/
dist/
**/dist/
**/node_modules/
**/coverage/

# Git
.git/
.gitignore

# Data & logs
data/
logs/
**/*.db*
**/*.log

# Configuration (user-specific)
dynamight.toml

# IDE, editor and tool caches
.idea/
.vscode/
.claude/
.codegraph/
**/*.swp
**/*.swo

# OS
**/.DS_Store
**/Thumbs.db

# Not needed in the image
.github/
docs/
assets/
scripts/
**/*.md
docker-compose.yml
Dockerfile
