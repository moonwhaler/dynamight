# =============================================================================
# Dynamight Configuration
# =============================================================================
# Copy this file to .env and customize the values below.
# Lines starting with # are comments. Uncomment options to enable them.
# =============================================================================

# -----------------------------------------------------------------------------
# Security (REQUIRED - Change in production!)
# -----------------------------------------------------------------------------

# Secret key for JWT token signing. Use a random string of at least 32 characters.
# Generate one with: openssl rand -base64 32
JWT_SECRET=your-secure-random-string-at-least-32-characters-long

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# SQLite database file location (relative or absolute path)
# The directory will be created automatically if it doesn't exist.
DATABASE_URL=sqlite:data/dynamight.db

# SQLite logs database file location (optional)
# Defaults to logs.db in the same directory as the main database.
# LOGS_DATABASE_URL=sqlite:data/logs.db

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Network interface to bind to (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# Port to listen on
PORT=8080

# Directory containing the frontend static files
STATIC_FILES_DIR=static

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------

# Timezone for scheduled jobs (e.g., UTC, America/New_York, Europe/London)
TZ=UTC

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log level configuration. Format: level or target=level,target=level
# Levels: trace, debug, info, warn, error
# Examples:
#   RUST_LOG=info                    - Info level for everything
#   RUST_LOG=warn,dynamight=debug    - Warn globally, debug for dynamight
#   RUST_LOG=error,dynamight=trace   - Error globally, trace for dynamight
RUST_LOG=info,dynamight=debug

# -----------------------------------------------------------------------------
# Log Rotation / History Retention
# -----------------------------------------------------------------------------

# Maximum number of job runs to keep per job. Older runs (and their logs) are
# automatically deleted after each job execution. Leave commented for unlimited.
# MAX_RUNS_PER_JOB=100

# -----------------------------------------------------------------------------
# Security - Filesystem Access
# -----------------------------------------------------------------------------

# Allowed paths for filesystem browsing (comma-separated).
# Users can only browse and create directories within these paths.
# Default: /mnt,/home,/media
# ALLOWED_BROWSE_PATHS=/mnt,/home,/media,/srv,/data

# Allowed CORS origins (comma-separated). Leave empty/unset for same-origin only.
# Default: same-origin only (most secure)
# Examples:
#   CORS_ORIGINS=https://myapp.example.com
#   CORS_ORIGINS=https://app1.example.com,https://app2.example.com
# For development with separate frontend server:
#   CORS_ORIGINS=http://localhost:5173
# CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Rate Limiting - Authentication
# -----------------------------------------------------------------------------

# Maximum failed authentication attempts before lockout.
# Applies to login, TOTP validation, and recovery code attempts.
# Default: 5
# RATE_LIMIT_MAX_ATTEMPTS=5

# Time window in seconds for tracking failed attempts.
# Default: 60 (1 minute)
# RATE_LIMIT_WINDOW_SECS=60

# Initial lockout duration in seconds after exceeding max attempts.
# Subsequent failures double this duration (exponential backoff).
# Default: 60 (1 minute)
# RATE_LIMIT_LOCKOUT_SECS=60

# Maximum lockout duration in seconds (caps the exponential backoff).
# Default: 3600 (1 hour)
# RATE_LIMIT_MAX_LOCKOUT_SECS=3600
