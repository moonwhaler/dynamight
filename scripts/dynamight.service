[Unit]
Description=Dynamight Backup Management System
Documentation=https://github.com/moonwhaler/dynamight
# Remote destinations (S3, SFTP, WebDAV, Drive) need the network at start-up
Wants=network-online.target
After=network-online.target local-fs.target

[Service]
Type=simple
# Runs as root: mounting and formatting backup drives needs it
WorkingDirectory=/opt/dynamight
Environment=DYNAMIGHT_CONFIG=/etc/dynamight/dynamight.toml
Environment=RUST_LOG=info,dynamight=debug
ExecStart=/opt/dynamight/dynamight
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dynamight

[Install]
WantedBy=multi-user.target
