[Unit]
Description=Dynamight Backup Management System
Documentation=https://github.com/moonwhaler/dynamight
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/dynamight
Environment=DYNAMIGHT_CONFIG=/etc/dynamight/dynamight.toml
Environment=RUST_LOG=info,dynamight=debug
ExecStart=/opt/dynamight/dynamight
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dynamight

[Install]
WantedBy=multi-user.target
