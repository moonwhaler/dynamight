[Unit]
Description=Dynamight Backup Management System
Documentation=https://github.com/your-repo/dynamight
After=network.target

[Service]
Type=simple
User=dynamight
Group=dynamight
WorkingDirectory=/opt/dynamight
EnvironmentFile=/etc/dynamight/.env
ExecStart=/opt/dynamight/dynamight
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/dynamight /var/log/dynamight

# Allow mounting drives (required for backup functionality)
# Remove these lines if running in Docker or not using mount features
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dynamight

[Install]
WantedBy=multi-user.target
